# 构建产物
/target/
/dist/

# 发布压缩包（pack-release.bat 生成）
/release/

# Tauri 构建时生成的 ACL schema
/gen/schemas/

# 编译出来的辅助工具（源码是 tools/*.rs）
*.exe
*.dll
*.pdb
*.lib

# 截图（验证用，不入库）
screenshot*.png

# 基准/性能脚本跑出来的报告与中间帧（生成物，不入库）
/tools/bench-results/
/tools/baseline-results/
/tools/compare-results/

# 系统/编辑器杂项
.DS_Store
Thumbs.db
*.log
